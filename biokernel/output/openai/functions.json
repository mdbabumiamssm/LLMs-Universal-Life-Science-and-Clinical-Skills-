[
  {
    "name": "calculate_qc_metrics",
    "description": "Calculate standard QC metrics for each cell",
    "parameters": {
      "type": "object",
      "properties": {
        "adata": {
          "type": "string",
          "description": "Annotated data matrix with raw counts"
        },
        "mito_prefix": {
          "type": "string",
          "description": "Prefix for mitochondrial genes",
          "default": "MT-"
        }
      },
      "required": [
        "adata"
      ]
    }
  },
  {
    "name": "filter_cells",
    "description": "Filter cells based on QC metrics using MAD-based thresholds",
    "parameters": {
      "type": "object",
      "properties": {
        "adata": {
          "type": "string",
          "description": "AnnData with QC metrics calculated"
        },
        "min_genes": {
          "type": "integer",
          "description": "Minimum genes per cell",
          "default": 200
        },
        "max_genes": {
          "type": "integer",
          "description": "Maximum genes per cell (None for MAD-based)",
          "default": null
        },
        "max_mito_pct": {
          "type": "number",
          "description": "Maximum mitochondrial percentage",
          "default": 20.0
        },
        "n_mads": {
          "type": "number",
          "description": "Number of MADs for outlier detection",
          "default": 5.0
        }
      },
      "required": [
        "adata",
        "min_genes",
        "max_genes",
        "max_mito_pct",
        "n_mads"
      ]
    }
  },
  {
    "name": "generate_qc_plots",
    "description": "Generate comprehensive QC visualization plots",
    "parameters": {
      "type": "object",
      "properties": {
        "adata": {
          "type": "string",
          "description": "AnnData with QC metrics"
        },
        "output_dir": {
          "type": "string",
          "description": "Directory to save plots",
          "default": "./qc_plots"
        }
      },
      "required": [
        "adata",
        "output_dir"
      ]
    }
  }
]